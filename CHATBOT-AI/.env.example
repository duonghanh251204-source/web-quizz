# Copy file này thành .env và điền API key của bạn

# --- LLM Provider (chọn 1 trong 3) ---
LLM_PROVIDER=gemini          # openai | gemini | ollama

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-flash

# Ollama (local, không cần key)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# --- App Settings ---
MAX_CHUNK_SIZE=2000
CHUNK_OVERLAP=200
DEFAULT_NUM_QUESTIONS=10
DEFAULT_DIFFICULTY=medium     # easy | medium | hard
MAX_FILE_SIZE_MB=20
