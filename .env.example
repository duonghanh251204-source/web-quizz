APP_NAME="PRX AI Quiz Platform"
APP_URL="http://localhost/PRX"

# Database: mysql (phpMyAdmin / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prx
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# AI_PROVIDER: openai | gemini | deepseek | mock (hoặc chatbot_ai nếu dùng dịch vụ Python)
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=60

# DeepSeek — API tương thích OpenAI (https://api.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=120

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=60

# Giới hạn độ dài ngữ cảnh gửi lên AI (mặc định 9000 ký tự). Giảm nhẹ (vd 6500) có thể giảm token đầu vào → hơi nhanh hơn nhưng bớt nội dung nguồn.
AI_DOCUMENT_CONTEXT_CHARS=9000

# OpenAI / DeepSeek: tách 2 request song song khi số câu >= AI_PARALLEL_MIN_QUESTIONS (curl_multi). Tắt = 0 nếu API giới hạn concurrent.
AI_PARALLEL_SPLIT=1
AI_PARALLEL_MIN_QUESTIONS=12