@startuml
skinparam classAttributeIconSize 0

package "Controllers" {
  class AuthController
  class DocumentController
  class QuizController
  class QuestionController
  class SubmissionController
}

package "Services" {
  class AuthService
  class DocumentTextExtractorService
  class QuizGenerationService
  class SubmissionEvaluationService
  interface AIProviderInterface
  class OpenAIProvider
  class MockAIProvider
}

package "Repository" {
  interface PlatformRepositoryInterface {
    +createQuestion()
    +updateQuestion()
    +deleteQuestion()
    +listQuestions()
  }
  class MysqlPlatformRepository
}

package "Domain" {
  class User
  class Document
  class Quiz
  class Question
  class Submission
}

Document "1" --> "*" Quiz
Quiz "1" --> "*" Question
Quiz "1" --> "*" Submission
User "1" --> "*" Submission

AuthController --> AuthService
DocumentController --> DocumentTextExtractorService
DocumentController --> PlatformRepositoryInterface
QuizController --> QuizGenerationService
QuizController --> SubmissionEvaluationService
QuizController --> PlatformRepositoryInterface
QuestionController --> PlatformRepositoryInterface
SubmissionController --> PlatformRepositoryInterface

MysqlPlatformRepository ..|> PlatformRepositoryInterface
QuizGenerationService --> AIProviderInterface
OpenAIProvider ..|> AIProviderInterface
MockAIProvider ..|> AIProviderInterface

@enduml
